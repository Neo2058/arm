APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty for current host (recommended). Do NOT put literal "null".
# For production with custom domain: SESSION_DOMAIN=.example.com  (with leading dot for subdomains if needed)
SESSION_DOMAIN=
# Force false until you have HTTPS. Setting true on HTTP-only site = cookies never sent on POST = 419 "page expired" on Livewire/Filament
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Redis is cache/sessions only. deferred writes jobs after the HTTP response.
QUEUE_CONNECTION=deferred

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=arm-documents   # IMPORTANT: valid S3/MinIO bucket name — lowercase letters, numbers, hyphens (-) ONLY. No underscores (_), no uppercase!
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram отключён, пока нет рабочего токена. Пустые значения — тихий no-op.
# Бот ключей — отдельный бот; username без @. См. TELEGRAM_SETUP.md.
TELEGRAM_KEY_BOT_TOKEN=
TELEGRAM_KEY_BOT_USERNAME=
TELEGRAM_KEY_WEBHOOK_SECRET=
# Бот административных уведомлений; legacy TELEGRAM_BOT_TOKEN/CHAT_ID используются только как fallback.
TELEGRAM_NOTIFICATIONS_BOT_TOKEN=
TELEGRAM_NOTIFICATIONS_CHAT_ID=
TELEGRAM_NOTIFICATIONS_QUEUE_CONNECTION=database
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_ID=
TELEGRAM_BOT_USERNAME=

# Direct (if unblocked)
# TELEGRAM_API_URL=https://api.telegram.org

# Relay (recommended: self-hosted in another region to bypass blocks)
# Только HTTPS; отдельный relay на каждый бот (каждый relay хранит свой токен).
TELEGRAM_RELAY_URL=
TELEGRAM_RELAY_SECRET=
TELEGRAM_KEY_RELAY_URL=
TELEGRAM_KEY_RELAY_SECRET=

# Chat (mobile API + tab). Filament ignores CHAT_ENABLED. Empty key is fine locally; production sets a real one.
CHAT_ENABLED=false
CHAT_PILOT_COLUMN=
CHAT_ENCRYPTION_KEY=
CHAT_PREVIOUS_KEYS=
CHAT_TIMEZONE=Europe/Moscow

# ClamAV client (discipline + later chat). Overlay still sets DISCIPLINE_CLAMD_CONFIG;
# DISCIPLINE_CLAMDSCAN / DISCIPLINE_CLAMD_CONFIG / DISCIPLINE_SCAN_TIMEOUT remain aliases.
# ANTIVIRUS_CLAMDSCAN=clamdscan
# ANTIVIRUS_SCAN_TIMEOUT=60
# ANTIVIRUS_CLAMD_CONFIG=/var/www/docker/clamav/clamd-client.conf

