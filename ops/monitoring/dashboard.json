{
  "uid": "arm-operations",
  "title": "ARM — сервер и приложение",
  "tags": [
    "ARM",
    "operations"
  ],
  "timezone": "Europe/Moscow",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU хоста",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arm-prometheus"
      },
      "targets": [
        {
          "expr": "arm_host_cpu_percent",
          "refId": "A",
          "legendFormat": "{{service}}{{kind}}{{status_class}}{{alert}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Занятая RAM",
      "type": "timeseries",
      "gridPos": {
