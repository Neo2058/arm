        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "arm-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - arm_host_memory_bytes{kind=\"MemAvailable\"} / ignoring(kind) arm_host_memory_bytes{kind=\"MemTotal\"})",
